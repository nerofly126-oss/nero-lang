# run with: ./nero eval examples/secrets.nero --yaml
# try:      DB_HOST=db.example.com ./nero eval examples/secrets.nero --yaml
# env("X", "fallback") reads an environment variable. env("X") alone is an error when X is not set.
# secret("X") is only a reference. The password is never read, so it cannot end up in the output.

type Database {
    host: str
    port: int = 5432
    user: str
    password: secret
}

fn database(stage: str) -> Database {
    return Database {
        host: env("DB_HOST", "db-{stage}.internal"),
        user: "app",
        password: secret("DB_PASSWORD_{stage}"),
    }
}

for stage in ["dev", "prod"] {
    emit database(stage)
}
