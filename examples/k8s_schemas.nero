# The Kubernetes schemas used by the demos. Use them with: import "k8s_schemas.nero"

type ObjectMeta {
    name: str
    labels: record = {}
    annotations: record = {}
}

type TemplateMeta {
    labels: record = {}
    annotations: record = {}
}

type ContainerPort {
    containerPort: int
    name: str = "http"
    protocol: str = "TCP"
}

type EnvVar {
    name: str
    value: str
}

type HTTPGetAction {
    path: str
    port: int
    scheme: str = "HTTP"
}

type Probe {
    httpGet: HTTPGetAction
    initialDelaySeconds: int = 0
    periodSeconds: int = 10
    timeoutSeconds: int = 1
    failureThreshold: int = 3
    successThreshold: int = 1
}

type ResourceList {
    cpu: str
    memory: str
}

type Resources {
    requests: ResourceList
    limits: ResourceList
}

type Container {
    name: str
    image: str
    imagePullPolicy: str
    ports: [ContainerPort]
    env: [EnvVar] = []
    readinessProbe: Probe
    livenessProbe: Probe
    resources: Resources
    securityContext: record = {}
    volumeMounts: [record] = []
    command: [str] = []
    args: [str] = []
}

type PodSpec {
    containers: [Container]
    serviceAccountName: str = ""
    automountServiceAccountToken: bool = false
    restartPolicy: str = "Always"
    terminationGracePeriodSeconds: int = 30
    dnsPolicy: str = "ClusterFirst"
    enableServiceLinks: bool = true
    imagePullSecrets: [record] = []
    initContainers: [Container] = []
    nodeSelector: record = {}
    securityContext: record = {}
    tolerations: [record] = []
    volumes: [record] = []
}

type PodTemplate {
    metadata: TemplateMeta
    spec: PodSpec
}

type LabelSelector {
    matchLabels: record
}

type DeploymentSpec {
    replicas: int
    selector: LabelSelector
    template: PodTemplate
    strategy: record = {}
    minReadySeconds: int = 0
    progressDeadlineSeconds: int = 600
    revisionHistoryLimit: int = 10
}

type Deployment {
    apiVersion: str = "apps/v1"
    kind: str = "Deployment"
    metadata: ObjectMeta
    spec: DeploymentSpec
}

type ServicePort {
    port: int
    targetPort: int
    protocol: str = "TCP"
    name: str = "http"
}

type ServiceSpec {
    selector: record
    ports: [ServicePort]
    type: str = "ClusterIP"
    sessionAffinity: str = "None"
}

type Service {
    apiVersion: str = "v1"
    kind: str = "Service"
    metadata: ObjectMeta
    spec: ServiceSpec
}
