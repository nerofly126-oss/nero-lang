# run with: ./nero eval examples/k8s_bad.nero --yaml
# the classic: a number quoted by accident. kubectl finds out late, n+ finds out now.

import "k8s_schemas.nero"

fn labels(app: str, env: str) -> record {
    return {app: app, env: env}
}

fn replicas_for(env: str) -> int {
    return if env == "prod" { 5 } else if env == "staging" { 2 } else { 1 }
}

fn deployment(app: str, env: str, version: str, replicas: int) -> Deployment {
    return Deployment {
        metadata: ObjectMeta { name: "{app}-{env}", labels: labels(app, env) },
        spec: DeploymentSpec {
            replicas: "{replicas}",
            selector: LabelSelector { matchLabels: {app: app} },
            template: PodTemplate {
                metadata: TemplateMeta { labels: labels(app, env) },
                spec: PodSpec {
                    containers: [
                        Container {
                            name: app,
                            image: "ghcr.io/nero/{app}:{version}",
                            ports: [ContainerPort { containerPort: 8080 }],
                            env: [EnvVar { name: "LOG_LEVEL", value: if env == "prod" { "info" } else { "debug" } }],
                            resources: Resources {
                                requests: ResourceList { cpu: "100m", memory: "128Mi" },
                                limits: ResourceList { cpu: if env == "prod" { "1" } else { "500m" }, memory: "256Mi" },
                            },
                        },
                    ],
                },
            },
        },
    }
}

fn service(app: str, env: str) -> Service {
    return Service {
        metadata: ObjectMeta { name: "{app}-{env}", labels: labels(app, env) },
        spec: ServiceSpec {
            selector: labels(app, env),
            ports: [ServicePort { port: 80, targetPort: 8080 }],
        },
    }
}

for env in ["dev", "staging", "prod"] {
    emit deployment("web", env, "1.4.2", replicas_for(env))
    emit service("web", env)
}
