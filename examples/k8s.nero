# run with: ./nero check examples/k8s.nero && ./nero eval examples/k8s.nero --yaml
# local image: docker build -t nero-demo-web:1.0.0 examples/k8s_app
# registry image: docker build -t ghcr.io/OWNER/nero-demo-web:1.0.0 examples/k8s_app
# set K8S_IMAGE and K8S_IMAGE_PULL_POLICY before eval to use a registry image
# load into kind: kind load docker-image nero-demo-web:1.0.0 --name nero-demo
# server-side validation: ./nero check examples/k8s.nero && ./nero eval examples/k8s.nero --yaml | kubectl apply --dry-run=server --validate=strict -f -

import "k8s_schemas.nero"

fn labels(app: str, env: str) -> record {
    return {app: app, env: env}
}

fn replicas_for(env: str) -> int {
    return if env == "prod" { 5 } else if env == "staging" { 2 } else { 1 }
}

fn deployment(app: str, env: str, image: str, pull_policy: str, replicas: int) -> Deployment {
    return Deployment {
        metadata: ObjectMeta { name: "{app}-{env}", labels: labels(app, env) },
        spec: DeploymentSpec {
            replicas: replicas,
            selector: LabelSelector { matchLabels: labels(app, env) },
            template: PodTemplate {
                metadata: TemplateMeta { labels: labels(app, env) },
                spec: PodSpec {
                    containers: [
                        Container {
                            name: app,
                            image: image,
                            imagePullPolicy: pull_policy,
                            ports: [ContainerPort { containerPort: 8080 }],
                            env: [
                                EnvVar { name: "APP_ENV", value: env },
                                EnvVar { name: "LOG_LEVEL", value: if env == "prod" { "info" } else { "debug" } },
                            ],
                            readinessProbe: Probe { httpGet: HTTPGetAction { path: "/healthz", port: 8080 } },
                            livenessProbe: Probe { httpGet: HTTPGetAction { path: "/healthz", port: 8080 } },
                            resources: Resources {
                                requests: ResourceList { cpu: "100m", memory: "128Mi" },
                                limits: ResourceList { cpu: if env == "prod" { "1" } else { "500m" }, memory: "256Mi" },
                            },
                            securityContext: {allowPrivilegeEscalation: false, runAsNonRoot: true},
                        },
                    ],
                },
            },
        },
    }
}

fn service(app: str, env: str) -> Service {
    return Service {
        metadata: ObjectMeta { name: "{app}-{env}", labels: labels(app, env) },
        spec: ServiceSpec {
            selector: labels(app, env),
            ports: [ServicePort { port: 80, targetPort: 8080 }],
        },
    }
}

for env in ["dev", "staging", "prod"] {
    let image = env("K8S_IMAGE", "nero-demo-web:1.0.0")
    let pull_policy = env("K8S_IMAGE_PULL_POLICY", "Never")
    emit deployment("web", env, image, pull_policy, replicas_for(env))
    emit service("web", env)
}
